{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "corepack enable && corepack prepare pnpm@11.15.1 --activate && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/dempo build",
  "outputDirectory": "artifacts/dempo/dist/public",
  "regions": ["bom1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
